<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Pet Store | Second-hand pet essentials</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="site-header">
      <nav class="container nav" aria-label="Main navigation">
        <%= link_to "🐾 Pet Store", root_path, class: "brand" %>
        <div class="nav-links">
          <%= link_to "Browse", root_path %>
          <% if authenticated? %>
            <%= link_to "My listings", my_listings_path %>
            <span class="user-name"><%= Current.user.name %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: "link-button" %>
            <%= link_to "Sell an item", new_listing_path, class: "button" %>
          <% else %>
            <%= link_to "Sign in", new_session_path %>
            <%= link_to "Create account", new_registration_path, class: "button" %>
          <% end %>
        </div>
      </nav>
    </header>
    <main class="container main">
      <% flash.each do |type, message| %>
        <div class="flash <%= type %>" role="<%= type == "alert" ? "alert" : "status" %>"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
    <footer class="container footer">Good things deserve a second life. · Pet Store</footer>
  </body>
</html>
