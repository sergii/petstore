<section class="form-panel panel"><h1>Choose a new password</h1><%= render "shared/errors", record: @user %><%= form_with url: password_path(params[:token]), method: :patch do |form| %><div class="field"><%= form.label :password %><%= form.password_field :password, required: true, minlength: 8, autocomplete: "new-password" %></div><div class="field"><%= form.label :password_confirmation, "Confirm password" %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %></div><%= form.submit "Update password", class: "button" %><% end %></section>
